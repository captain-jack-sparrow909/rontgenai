# ── Production (Render) — set in Render Dashboard → Environment
# Do NOT commit real values.

NODE_ENV=production
PORT=10000
JOB_EXECUTION_MODE=worker
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=2
JOB_STALE_AFTER_SECONDS=900
RATE_LIMIT_READ_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=60
UPLOAD_MAX_BYTES=10485760
ARTIFACT_RETENTION_DAYS=30
ENABLE_GENERIC_JOB_API=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
KEEPALIVE_CRON_SECRET=

# Frontend origin(s) for CORS (comma-separated)
APP_URL=https://rontgenai.dev
CORS_ORIGINS=https://rontgenai.dev,https://www.rontgenai.dev

# Clerk Production secret
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_API_ENDPOINT=

# Paddle (sandbox until production checkout step)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_YEARLY=

# GitHub (Sentinel / Forge / Atlas rate limits)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
