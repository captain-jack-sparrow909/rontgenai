NODE_ENV=development
PORT=8000
JOB_EXECUTION_MODE=inline
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=2
JOB_STALE_AFTER_SECONDS=900
RATE_LIMIT_READ_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=60
UPLOAD_MAX_BYTES=10485760
ARTIFACT_RETENTION_DAYS=30
ENABLE_GENERIC_JOB_API=false
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Clerk (use Development keys for localhost)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# optional
CLERK_WEBHOOK_SECRET=

# Supabase (service role — server only)
SUPABASE_URL=
# or NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — falls back to Postgres counts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional locally, recommended in production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional locally; required for POST /v1/keepalive (minimum 32 characters)
KEEPALIVE_CRON_SECRET=

# Paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_YEARLY=

# Inngest (optional job emit)
INNGEST_EVENT_KEY=

# Optional: GitHub token for Atlas rate limits
GITHUB_TOKEN=

# Sentinel · GitHub App (optional; PAT works for manual PR review)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
