NODE_ENV=development
PORT=8000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Clerk (use Development keys for localhost)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# optional
CLERK_WEBHOOK_SECRET=

# Supabase (service role — server only)
SUPABASE_URL=
# or NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — falls back to Postgres counts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_YEARLY=

# Inngest (optional job emit)
INNGEST_EVENT_KEY=

# Optional: GitHub token for Atlas rate limits
GITHUB_TOKEN=

# Sentinel · GitHub App (optional; PAT works for manual PR review)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
