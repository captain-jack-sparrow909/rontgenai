# ── Dependencies & package managers ─────────────────
node_modules/
.npm-cache/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp
.pnp.*

# ── Environment & secrets (never commit) ────────────
# All env files except committed templates
.env
.env.*
!.env.example
!.env*.example

# Explicit secret / credential filenames
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
*.secrets
secrets/
.secrets/
credentials.json
**/credentials.json
**/service-account*.json
**/firebase-adminsdk*.json
**/google-services.json
.gcloud/
.aws/credentials
.aws/config
*.tfvars
!*.tfvars.example

# API keys / tokens often dropped as loose files
*secrets*.json
*credentials*.yml
*credentials*.yaml
*credentials*.toml
local.settings.json

# Clerk / auth local dumps
.clerk/
clerk.toml

# ── Cloud / deploy tooling ──────────────────────────
.vercel/
.netlify/
.supabase/
.wrangler/
.dev.vars
.sentryclirc
.sentry/

# ── Build outputs ───────────────────────────────────
.next/
out/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# ── Logs & debug ────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ── OS / IDE ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc local ──────────────────────────────────────
tmp/
temp/
.cache/
*.local
