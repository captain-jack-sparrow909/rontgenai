# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (https://dashboard.clerk.com) ──────────────
# IMPORTANT — Production keys encode your Clerk Frontend API host.
# If the key decodes to clerk.rontgenai.dev, that DNS CNAME MUST exist
# or you will see: failed_to_load_clerk_js.
# For local dev without DNS, use Development keys (pk_test_ / sk_test_).
# See docs/CLERK-DNS.md

# App id: some-id-here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# ── Supabase ─────────────────────────────────────────
# Use project URL only (https://xxxx.supabase.co) — not /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rontgenai
R2_PUBLIC_BASE_URL=

# ── Paddle ───────────────────────────────────────────
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs (create in Paddle sandbox)
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_YEARLY=

# ── DeepSeek ─────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Email (Spacemail SMTP) ───────────────────────────
SPACEMAIL_SMTP_URL=
EMAIL_FROM=hello@rontgenai.dev
EMAIL_SUPPORT=support@rontgenai.dev

# ── Upstash Redis ────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── PostHog ──────────────────────────────────────────
# Must be Project API Key (starts with phc_), NOT personal API key (phx_).
# PostHog → Project settings → Project API Key
# EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry (optional Phase 0) ────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Inngest (Phase 1 jobs) ───────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── API gateway (future separate service) ────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
