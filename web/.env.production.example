# ── Production (Vercel) — set in Vercel Project → Settings → Environment Variables
# Do NOT commit real values.

NEXT_PUBLIC_APP_URL=https://rontgenai.dev
NEXT_PUBLIC_API_URL=https://api.rontgenai.dev

# Clerk — use Production instance keys (pk_live_ / sk_live_) for rontgenai.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog (project key phc_…)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Paddle — sandbox first, then live after go-live
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
